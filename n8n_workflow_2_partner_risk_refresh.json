    {
      "parameters": {
        "jsCode": "// Simulates a real NPA/fund-utilization feed from NBCFDC/SCA MIS\nreturn $input.all().map(item => {\n  let risk = item.json.risk_score || 50;\n  let change = Math.floor(Math.random() * 11) - 5;\n  risk = Math.max(0, Math.min(100, risk + change));\n  item.json.risk_score = risk;\n  item.json.last_updated = new Date().toISOString();\n  return item;\n});"
      },
      "id": "3",
      "name": "Simulate Risk Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [400, 0]
    },
